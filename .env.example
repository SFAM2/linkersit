# Server-only variables: add these to Vercel Settings > Environment Variables.
SITE_URL=https://linkersit.com
RESEND_API_KEY=
# Must be an address on a domain verified in Resend.
CONTACT_FROM_EMAIL=contact@linkersit.com
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_ALLOWED_HOSTS=linkersit.com,www.linkersit.com

# Optional: shared rate limiting across Vercel instances (Upstash Redis).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
